# Local environments, editor files and generated bytecode.
.venv/
__pycache__/
*.py[cod]
.DS_Store
.history/
.env
.env.*

# Scratch and local deployment bundles.
tmp/
_site/
dist/

# Retain only the headless engine's durable snapshot, not achievement scratch data.
/cache/*
!/cache/telemetry_cache.json

# Retain only the dashboard dataset, not local CSV/Excel reports or archives.
/output/*
!/output/data.json
!/output/art/
